+size_t TcpConnectionImpl::pendingWriteBytes() const
+{
+    loop_->assertInLoopThread();
+    const auto unavailable = (std::numeric_limits<size_t>::max)();
+    if (tlsProviderPtr_)
+        return unavailable;
+
+    size_t pending = 0;
+    for (const auto &node : writeBufferList_)
+    {
+        // Synchronous stream remainingBytes() is a 0/1 availability marker,
+        // and file nodes may count bytes that have not been read into memory.
+        if (node->isFile() || (node->isStream() && !node->isAsync()))
+            return unavailable;
+        const auto remaining = node->remainingBytes();
+        if (remaining < 0 ||
+            static_cast<unsigned long long>(remaining) >
+                static_cast<unsigned long long>(unavailable - pending))
+            return unavailable;
+        pending += static_cast<size_t>(remaining);
+    }
+    return pending;
+}
